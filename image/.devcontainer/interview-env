#!/usr/bin/env bash
# Runs on every codespace start (postStartCommand). Wires up the AI keys the
# interviewer provided and checks the toolchain. Safe to re-run: `interview-env`.

if [ -n "${INTERVIEW_ANTHROPIC_KEY:-}" ]; then
  mkdir -p ~/.claude
  [ -f ~/.claude/settings.json ] || echo '{"apiKeyHelper": "printenv INTERVIEW_ANTHROPIC_KEY"}' > ~/.claude/settings.json
  [ -f ~/.claude.json ] || echo '{"hasCompletedOnboarding": true}' > ~/.claude.json
fi
if [ -n "${INTERVIEW_OPENAI_KEY:-}" ]; then
  printenv INTERVIEW_OPENAI_KEY | codex login --with-api-key >/dev/null 2>&1 || echo "warning: codex login failed"
fi

problems=()
python3 --version 2>&1 | grep -q "Python 3.13" || problems+=("python is not 3.13 ($(python3 --version 2>&1))")
for tool in uv claude codex; do command -v "$tool" >/dev/null || problems+=("$tool is not installed"); done

echo
if [ ${#problems[@]} -eq 0 ]; then
  echo "============================================================"
  echo "  ENVIRONMENT READY"
  echo "  claude: $([ -n "${INTERVIEW_ANTHROPIC_KEY:-}" ] && echo "access provided" || echo "log in with your own account")"
  echo "  codex:  $([ -n "${INTERVIEW_OPENAI_KEY:-}" ] && echo "access provided" || echo "log in with your own account")"
  echo "============================================================"
else
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  echo "  ENVIRONMENT PROBLEM - tell your interviewer:"
  printf '   - %s\n' "${problems[@]}"
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  exit 1
fi
