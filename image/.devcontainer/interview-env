#!/usr/bin/env bash
# Runs on every codespace start (postStartCommand). Wires up the AI keys the
# interviewer provided and checks the toolchain. Safe to re-run: `interview-env`.

anthropic=$(interview-key INTERVIEW_ANTHROPIC_KEY)
openai=$(interview-key INTERVIEW_OPENAI_KEY)

if [ -n "$anthropic" ]; then
  mkdir -p ~/.claude
  # The provided key belongs to a HIPAA-configured org, which rejects Claude Code's
  # experimental API betas (e.g. context_management), so turn those off.
  [ -f ~/.claude/settings.json ] || cat > ~/.claude/settings.json <<'JSON'
{
  "apiKeyHelper": "interview-key INTERVIEW_ANTHROPIC_KEY",
  "env": { "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1" }
}
JSON
  # Skip first-run onboarding and the "trust this folder?" prompt for the workspace.
  [ -f ~/.claude.json ] || printf '{"hasCompletedOnboarding": true, "projects": {"%s": {"hasTrustDialogAccepted": true}}}\n' \
    "${CODESPACE_VSCODE_FOLDER:-$PWD}" > ~/.claude.json
fi
if [ -n "$openai" ]; then
  printf %s "$openai" | codex login --with-api-key >/dev/null 2>&1 || echo "warning: codex login failed"
fi

problems=()
python3 --version 2>&1 | grep -q "Python 3.13" || problems+=("python is not 3.13 ($(python3 --version 2>&1))")
have_anthropic=${anthropic:+yes}; have_openai=${openai:+yes}
unset anthropic openai

for tool in uv claude codex; do command -v "$tool" >/dev/null || problems+=("$tool is not installed"); done

echo
if [ ${#problems[@]} -eq 0 ]; then
  echo "============================================================"
  echo "  ENVIRONMENT READY"
  echo "  claude: $([ -n "$have_anthropic" ] && echo "access provided" || echo "log in with your own account")"
  echo "  codex:  $([ -n "$have_openai" ] && echo "access provided" || echo "log in with your own account")"
  echo "============================================================"
else
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  echo "  ENVIRONMENT PROBLEM - tell your interviewer:"
  printf '   - %s\n' "${problems[@]}"
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  exit 1
fi
